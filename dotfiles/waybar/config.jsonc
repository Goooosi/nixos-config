{
  "reload_style_on_change": true,
  "position": "top",
  "spacing": 0,
  "height": 32,
  "margin": "0 6 0 6",

  "modules-left": ["custom/launcher", "mango/workspaces", "mango/window"],
  "modules-center": ["mpris", "clock", "idle_inhibitor"],
  "modules-right": [
    "mango/layout",
    "group/tray-expander",
    "backlight",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "memory",
    "battery"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "fuzzel",
    "tooltip": false
  },

  "mango/workspaces": {
    "format": "{name}",
    "overview-label": "󰍉"
  },

  "mango/window": {
    "format": "{title} - {app_id}",
    "max-length": 45,
    "rewrite": {
      " - ": "",
      "(.*?) - Chromium - chromium": "  $1 ",
      "(.*chrome)...(.*)": "  $1 ",
      "(.*) - Obsidian - .* - obsidian": "  $1 ",
      "(.*nvim)...(.*)": "  $2 ",
      "(.*code) - (.*)": " 󰨞 $1 ",
      "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
      "^.*cmatrix( .*|$)": " 󰘨 MATRIX $1 ",
      "(.*) - Spotify": "  $1 ",
      "(.*) - com.mitchellh.ghostty": " 󰊠 $1 ",
      "(.*) - kitty": " 󰄛  $1 ",
      "(.*) - BeeperTexts": " 󰻞  $1 ",
      "(.*Discord)...(.*).. (.*)": "  $2 ",
      "(.*) - org.gnome.Nautilus": " 󰣆 $1 ",
      "(.*) - fish": "  [$1] ",
      "(.*Steam)...(.*)": " $1",
      "(.*imv)...(.*).. (.*)": " $2",
      "(.*) - com.obsproject.Studio": "  $1 "
    }
  },

  "mango/layout": {
    "format": "{symbol}"
  },

  "mpris": {
    "format": "󰋎",
    "format-paused": "<span color='grey'>{status_icon}</span>",
    "max-length": 20,
    "player-icons": { "default": "⏸", "mpv": "🎵" },
    "status-icons": { "paused": "▶" },
    "ignored-players": ["firefox", "chromium", "brave"]
  },

  "clock": {
    "format": "{:L%A: %H:%M}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰛊", "deactivated": "󰾫" }
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon}",
    "tooltip-format": "{percent}%",
    "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"]
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty -e bluetui"
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "kitty -e nmtui"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "on-click": "kitty -e wiremix",
    "on-click-right": "pamixer -t"
  },

  "cpu": {
    "interval": 2,
    "format": "󰻠 {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "󰍛 {percentage}%",
    "on-click": "kitty -e btop"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-full": "󰂅 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5,
    "states": { "warning": 20, "critical": 10 }
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": " ",
    "tooltip": false
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12
  }
}
