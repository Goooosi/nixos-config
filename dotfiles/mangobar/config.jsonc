{
  "layer": "top",
  "position": "top",
  "width": "auto",
  "spacing": 14,
  "margin-top": 10,
  "margin-left": 400,
  "margin-right": 400,

  "modules-left": [
    "custom/applauncher",
    "mango/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/temp",
    "cpu",
    "battery",
    "tray",
    "custom/power"
  ],
  "custom/temp": {
    "exec": "/run/current-system/sw/bin/awk '{printf \"%d°C\", $1/1000}' /sys/class/hwmon/hwmon4/temp1_input",
    "interval": 2,
    "format": "  {}"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": false
  },

  "mango/workspaces": {
    "disable-scroll": true,
    "tooltip": false
  },

  "custom/applauncher": {
    "format": "〇",
    "on-click": "sh -c 'pkill fuzzel||(fuzzel --no-exit-on-keyboard-focus-loss&slurp -p -b 00000000 >/dev/null 2>&1&wait -n;pkill slurp;pkill fuzzel)'",
    "tooltip": false
  },

  "tray": {
    "spacing": 6,
    "tooltip": false
  },
    
  "clock": {
    "format": "  {:L%b %d · %A} ·   {:L%I:%M %p}",
    "tooltip": false
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "sh -c 'choice=$(printf \"Lock\\nSuspend\\nReboot\\nShutdown\" | fuzzel --dmenu --prompt=\"System ❯ \"); case \"$choice\" in Lock) pkill -SIGUSR1 swayidle ;; Suspend) systemctl suspend ;; Reboot) systemctl reboot ;; Shutdown) systemctl poweroff ;; esac'",
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {percent}%",
    "format-charging": " {percent}%",
    "format-plugged": " {percent}%",
    "format-alt": "{icon} {time}",
    "format-full": "  {percent}%",
    "format-icons": [ " ", " ", " " ]
  }
}

