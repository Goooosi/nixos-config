(defvar osd_value 0)
(defvar osd_icon "")
(defvar osd_text "0%")

(defwindow osd
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "100px"
                      :width "260px"
                      :height "60px"
                      :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  (box :class "osd-box" :orientation "h" :space-evenly false :spacing 15
    (label :class "osd-icon" :text osd_icon)
    (scale :class "osd-progress"
           :value osd_value
           :orientation "h"
           :flipped false
           :max 101
           :min 0)
    (label :class "osd-percentage" :text osd_text)))

(defvar help_opacity 1.0)

(defwindow screenshot-help
  :monitor 0
  :geometry (geometry :x "0px"
                      :y "20px"
                      :anchor "bottom center")
  :stacking "overlay"
  :exclusive false
  (box :style "opacity: ${help_opacity}; transition: opacity 0.15s ease;"
       :class "help-box" :orientation "v" :space-evenly false :spacing 10
    (label :class "help-title" :text "  Screenshot Guide" :halign "start")
    (box :class "help-row" :space-evenly false :spacing 15
      (label :class "help-key" :text " Drag ")
      (label :class "help-desc" :text "Select Region"))
    (box :class "help-row" :space-evenly false :spacing 15
      (label :class "help-key" :text "Space")
      (label :class "help-desc" :text "Save File + Clipboard"))
    (box :class "help-row" :space-evenly false :spacing 15
      (label :class "help-key" :text "  C  ")
      (label :class "help-desc" :text "Clipboard Only"))
    (box :class "help-row" :space-evenly false :spacing 15
      (label :class "help-key" :text "  P  ")
      (label :class "help-desc" :text "Toggle Cursor Visibility"))
    (box :class "help-row" :space-evenly false :spacing 15
      (label :class "help-key" :text " Esc ")
      (label :class "help-desc" :text "Cancel & Exit"))))
