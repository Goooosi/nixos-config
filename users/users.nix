{ inputs, pkgs, ... }:

{
  # Raw NixOS user configurations exposed natively at the top level
  users.users.root.hashedPassword = "!";
  users.users."zi" = {
    isNormalUser = true;
    description = "zi";
    extraGroups = [ "networkmanager" "wheel" ];
    packages = with pkgs; [];
  };

  home-manager = {
    useUserPackages = true;
    extraSpecialArgs = { inherit inputs; };
    users.zi = {
      imports = [
        # Correctly links to your zi module path generated by import-tree
       ./zi.nix 
      ];
    };
  };
}

